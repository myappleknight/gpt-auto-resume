<Window x:Class="GPTAutoResume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPT Auto Resume" Height="780" Width="430" MinHeight="740" MinWidth="400" MaxWidth="460"
        Background="#F7FAFB"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app-icon.ico">
  <Window.Resources>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="SoftButton" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="BorderBrush" Value="#D8E4EF" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="InlineTextBox" TargetType="TextBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0,6,0,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#D8E4EF" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Foreground" Value="#12213F" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E0E8F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="SwitchTrack" CornerRadius="15" Background="#16866A">
              <Grid>
                <TextBlock x:Name="SwitchText"
                           Text="{TemplateBinding Content}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="White" />
                <Ellipse x:Name="SwitchKnob"
                         Width="22"
                         Height="22"
                         Fill="White"
                         HorizontalAlignment="Right"
                         Margin="0,0,4,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="False">
                <Setter TargetName="SwitchTrack" Property="Background" Value="#CBD5E1" />
                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Left" />
                <Setter TargetName="SwitchKnob" Property="Margin" Value="4,0,0,0" />
                <Setter TargetName="SwitchText" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="SwitchText" Property="Margin" Value="0,0,8,0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderBrush" Value="#D8E4EF" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="126" />
      <RowDefinition Height="*" />
      <RowDefinition Height="296" />
      <RowDefinition Height="30" />
      <RowDefinition Height="44" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="16,6,16,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Image Width="22" Height="22" Source="pack://application:,,,/Assets/app-icon.png" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Text="{Binding HeaderTitle}"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 FontSize="13"
                 FontWeight="Bold"
                 Foreground="#102033" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="&#xE774;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="13"
                   Margin="0,7,6,0"
                   Foreground="#0F172A" />
        <ComboBox ItemsSource="{Binding Languages}"
                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Code"
                  DisplayMemberPath="DisplayName"
                  Width="112" />
      </StackPanel>
    </Grid>

    <Button Grid.Row="1"
            Margin="0"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            BorderThickness="0"
            Background="#FFFFFF"
            Command="{Binding OpenBannerLinkCommand}">
      <Grid ClipToBounds="True">
        <Rectangle Fill="#FFFFFF" />
        <Image Source="{Binding BannerImage}"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Margin="0"
               Visibility="{Binding BannerVisibility}" />
        <TextBlock Text="{Binding CatDisabledLabel}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#7B8794"
                   FontSize="12"
                   Visibility="{Binding BannerOffVisibility}" />
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20,14,14,0"
                    MaxWidth="225">
          <TextBlock Text="{Binding StudioPresents}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="#16866A" />
          <TextBlock Text="{Binding Tagline}"
                     Margin="0,5,0,0"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#102033"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Button>

    <Grid Grid.Row="2" Margin="28,18,28,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Visibility="{Binding NonCountdownVisibility}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Ellipse Width="14" Height="14" Fill="{Binding StatusDotBackground}" Margin="0,4,9,0" />
          <TextBlock Text="{Binding MainStatus}"
                     FontSize="23"
                     FontWeight="SemiBold"
                     Foreground="{Binding StatusAccent}" />
        </StackPanel>
        <TextBlock Text="{Binding MainMessage}"
                   Margin="0,20,0,0"
                   HorizontalAlignment="Center"
                   FontSize="14"
                   Foreground="#64748B" />
        <TextBlock Text="{Binding SubMessage}"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   Foreground="#64748B"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button Content="{Binding ConfirmResumeLabel}"
                Command="{Binding ConfirmResumeCommand}"
                Visibility="{Binding ReadyButtonVisibility}"
                Margin="0,24,0,0"
                Width="150"
                Height="40"
                HorizontalAlignment="Center"
                Background="#16866A"
                BorderBrush="#16866A"
                Foreground="White"
                FontWeight="SemiBold" />
      </StackPanel>

      <StackPanel Visibility="{Binding CountdownVisibility}" VerticalAlignment="Center">
        <Border HorizontalAlignment="Center" Background="#FFF4D8" CornerRadius="13" Padding="12,5">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="#B7791F" Margin="0,5,7,0" />
            <TextBlock Text="{Binding MainMessage}" FontSize="12" Foreground="#856404" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Remaining}"
                   Margin="0,22,0,0"
                   HorizontalAlignment="Center"
                   FontSize="54"
                   FontWeight="Bold"
                   Foreground="#101828"
                   FontFamily="Segoe UI" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
          <TextBlock Text="&#xE823;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="13"
                     Foreground="#6B7280"
                     Margin="0,1,7,0" />
          <TextBlock Text="{Binding RetryAtInline}"
                     FontSize="13"
                     Foreground="#6B7280"
                     FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Text="{Binding SubMessage}"
                   Margin="0,28,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="#8A95A3" />
      </StackPanel>

      <Border Grid.Row="1"
              Width="148"
              Height="6"
              CornerRadius="3"
              HorizontalAlignment="Center"
              Margin="0,10,0,0"
              Background="#EEF2F5">
        <Border Width="44"
                Height="6"
                CornerRadius="3"
                HorizontalAlignment="Right"
                Background="#9FE8CC" />
      </Border>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="46,0,46,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding AutoResumeLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#12213F" />
            <TextBlock Text="{Binding AutoResumeDescription}" Margin="0,4,74,0" FontSize="10" Foreground="#8A95A3" TextWrapping="Wrap" />
          </StackPanel>
          <CheckBox Grid.Column="1"
                    Style="{StaticResource ToggleSwitch}"
                    Content="{Binding AutoResumeState}"
                    IsChecked="{Binding AutoResumeEnabled, Mode=TwoWay}"
                    VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding RecentWorkLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1"
                  Command="{Binding RefreshWorkCommand}"
                  Height="20"
                  Margin="8,0,8,0"
                  Padding="0"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="#16866A"
                  FontSize="10"
                  FontWeight="SemiBold"
                  Cursor="Hand">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="0,2,4,0" />
              <TextBlock Text="{Binding RefreshWorkLabel}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2"
                  Content="{Binding ShowAllLabel}"
                  Command="{Binding ToggleRecentWorkCommand}"
                  Visibility="{Binding ShowAllRecentWorkVisibility}"
                  Height="20"
                  Padding="0"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="#8A95A3"
                  FontSize="10"
                  Cursor="Hand" />
        </Grid>

        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding WorkSelectionScopeNotice}"
                     Margin="0,0,0,5"
                     FontSize="9"
                     Foreground="#A0AAB6"
                     TextWrapping="Wrap" />
          <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentWorkSelections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="28" Margin="0,1,0,0" ToolTip="{Binding DisplayTitle}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Width="18"
                            VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding DisplayTitle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           Margin="2,0,6,0"
                           Padding="2,1"
                           Height="23"
                           FontSize="11"
                           BorderThickness="0"
                           Background="Transparent"
                           Foreground="#12213F" />
                  <TextBlock Grid.Column="2"
                             Text="&#xE70F;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="10"
                             Foreground="#B3BDC8"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock
                     Grid.Row="1"
                     Text="{Binding NoRecentWorkLabel}"
                     Visibility="{Binding RecentWorkEmptyVisibility}"
                     Margin="0,8,0,0"
                     FontSize="11"
                     Foreground="#A0AAB6"
                     TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="3" Background="#EEF2F5" Margin="0,12,0,10" Height="1" />

        <Grid Grid.Row="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ResumeMessageLabel}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#8A95A3"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{Binding ResetResumeMessageLabel}"
                    Command="{Binding ResetResumeMessageCommand}"
                    Height="18"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#A0AAB6"
                    FontSize="10"
                    VerticalAlignment="Center"
                    Cursor="Hand" />
            <TextBlock Grid.Column="2"
                       Text="&#xE70F;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="11"
                       Foreground="#B3BDC8"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
          <TextBox Grid.Row="1"
                   Text="{Binding ResumeText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource InlineTextBox}"
                   Margin="0,5,0,0"
                   TextWrapping="NoWrap" />
        </Grid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#A0AAB6" Margin="0,1,5,0" />
      <TextBlock Text="{Binding LastCheckLabel}" FontSize="10" Foreground="#A0AAB6" />
      <TextBlock Text="{Binding LastCheck}" Margin="4,0,8,0" FontSize="10" Foreground="#8A95A3" />
      <TextBlock Text="•" FontSize="10" Foreground="#C8D0D9" />
      <Button Command="{Binding RefreshQuotaCommand}"
              ToolTip="{Binding QuotaProbeTooltip}"
              Margin="8,0,8,0"
              Padding="0"
              BorderThickness="0"
              Background="Transparent"
              Cursor="Hand">
        <TextBlock Text="{Binding QuotaProbeText}" FontSize="10" Foreground="#8A95A3" TextTrimming="CharacterEllipsis" MaxWidth="130" />
      </Button>
      <TextBlock Text="•" FontSize="10" Foreground="#C8D0D9" />
      <TextBlock Text="{Binding TargetAppLabel}" Margin="8,0,4,0" FontSize="10" Foreground="#A0AAB6" />
      <TextBlock Text="ChatGPT/Codex" FontSize="10" Foreground="#8A95A3" />
    </StackPanel>

    <Grid Grid.Row="5" Background="#FFFFFF">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" />
          <TextBlock Text="{Binding SettingsLabel}" FontSize="12" />
        </StackPanel>
      </Button>

      <Menu Grid.Column="1" VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
        <MenuItem Header="{Binding MoreLabel}" FontSize="12">
          <MenuItem Header="{Binding DiagnosticsLabel}" Command="{Binding DiagnosticsCommand}" />
          <MenuItem Header="{Binding CaptureLimitLabel}" Command="{Binding CaptureLimitCommand}" />
          <MenuItem Header="{Binding PossibleLimitDiagnosticsLabel}" Command="{Binding OpenPossibleLimitDiagnosticsCommand}" />
          <Separator />
          <MenuItem Header="{Binding AboutLabel}" Command="{Binding OpenHomepageCommand}" />
        </MenuItem>
      </Menu>

      <Button Grid.Column="3" Style="{StaticResource IconButton}" Command="{Binding OpenHomepageCommand}" Margin="0,0,10,0" ToolTip="EasyLifeHub｜生活神器">
        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#16866A" />
      </Button>
    </Grid>
  </Grid>
</Window>
