<Window x:Class="GPTAutoResume.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding SettingsTitle}" Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFE"
        Icon="pack://application:,,,/Assets/app-icon.ico">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderBrush" Value="#D4E0EF" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="{Binding SettingsTitle}" FontSize="24" FontWeight="SemiBold" Foreground="#12213F" />

      <Border Margin="0,20,0,0" Padding="18" Background="White" BorderBrush="#D9E4F2" BorderThickness="1" CornerRadius="12">
        <StackPanel>
          <TextBlock Text="{Binding GeneralLabel}" FontSize="16" FontWeight="SemiBold" />
          <CheckBox Content="{Binding AutoResumeLabel}" IsChecked="{Binding AutoResumeEnabled}" />
          <TextBlock Text="{Binding ResumeMessageLabel}" Margin="0,16,0,6" Foreground="#64748B" />
          <TextBox Text="{Binding ResumeText, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="{Binding ResetResumeMessageLabel}"
                  Command="{Binding ResetResumeMessageCommand}"
                  Margin="0,8,0,0"
                  HorizontalAlignment="Left"
                  Padding="12,5"
                  Background="Transparent"
                  BorderBrush="#D4E0EF"
                  Foreground="#64748B" />
          <TextBlock Text="{Binding SafetyDelayLabel}" Margin="0,14,0,6" Foreground="#64748B" />
          <TextBox Text="{Binding Config.ResumeDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="{Binding ResumePolicyLabel}" Margin="0,14,0,6" Foreground="#64748B" />
          <ComboBox ItemsSource="{Binding ResumePolicies}"
                    SelectedValue="{Binding Config.ResumePolicy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Value"
                    DisplayMemberPath="DisplayName"
                    Height="36" />
          <CheckBox Content="{Binding StartWithWindowsLabel}" IsChecked="{Binding Config.StartWithWindows}" />
        </StackPanel>
      </Border>

      <Border Margin="0,16,0,0" Padding="18" Background="White" BorderBrush="#D9E4F2" BorderThickness="1" CornerRadius="12">
        <StackPanel>
          <TextBlock Text="{Binding AppearanceLabel}" FontSize="16" FontWeight="SemiBold" />
          <CheckBox Content="{Binding CatBannerLabel}" IsChecked="{Binding Config.CatBannerEnabled}" />
          <TextBlock Text="{Binding RefreshBannerLabel}" Margin="0,14,0,6" Foreground="#64748B" />
          <TextBox Text="{Binding Config.BannerRefreshMinutes, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="{Binding RefreshBannerNowLabel}" Command="{Binding RefreshBannerCommand}" Margin="0,12,0,0" Height="38" />
          <TextBlock Text="Language" Margin="0,14,0,6" Foreground="#64748B" />
          <ComboBox ItemsSource="{Binding Languages}"
                    SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Code"
                    DisplayMemberPath="DisplayName"
                    Height="36" />
        </StackPanel>
      </Border>

      <Border Margin="0,16,0,0" Padding="18" Background="#FFF8E7" BorderBrush="#F5D48B" BorderThickness="1" CornerRadius="12">
        <StackPanel>
          <TextBlock Text="{Binding AdvancedLabel}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding AlphaSafetyLabel}" Margin="0,12,0,0" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ExperimentalAutomationLabel}" Margin="0,4,0,0" Foreground="#8A5A00" />
          <CheckBox Content="{Binding DryRunLabel}" IsChecked="{Binding Config.DryRun}" />
          <CheckBox Content="{Binding SendEnterLabel}" IsChecked="{Binding Config.SendEnter}" />
          <CheckBox Content="{Binding AllowRealSubmitLabel}" IsChecked="{Binding Config.AllowRealSubmit}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
