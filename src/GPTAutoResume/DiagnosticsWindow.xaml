<Window x:Class="GPTAutoResume.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DiagnosticsLabel}" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFE"
        Icon="pack://application:,,,/Assets/app-icon.ico">
  <StackPanel Margin="24">
    <TextBlock Text="{Binding DiagnosticsLabel}" FontSize="24" FontWeight="SemiBold" Foreground="#12213F" />
    <TextBlock Text="Reports are written locally to the diagnostics folder." Margin="0,8,0,18" Foreground="#64748B" />

    <UniformGrid Columns="2" Rows="2">
      <Button Command="{Binding DiscoveryCommand}" Height="50" Margin="0,0,10,10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
          <TextBlock Text="{Binding UiaDiscoveryLabel}" />
        </StackPanel>
      </Button>
      <Button Command="{Binding CaptureLimitCommand}" Height="50" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
          <TextBlock Text="{Binding CaptureLimitLabel}" />
        </StackPanel>
      </Button>
      <Button Command="{Binding TestModeCommand}" Height="50" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
          <TextBlock Text="{Binding DeveloperTestLabel}" />
        </StackPanel>
      </Button>
      <Button Command="{Binding WrongWindowProbeCommand}" Height="50">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
          <TextBlock Text="{Binding WrongWindowProbeLabel}" />
        </StackPanel>
      </Button>
    </UniformGrid>

    <Border Margin="0,20,0,0" Padding="14" Background="#FFFFFF" BorderBrush="#D9E4F2" BorderThickness="1" CornerRadius="10">
      <TextBlock Text="{Binding ResumeStatus}" TextWrapping="Wrap" Foreground="#334155" />
    </Border>
  </StackPanel>
</Window>
